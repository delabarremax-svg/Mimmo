{
  "name": "mimmo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-document-assets.mjs && vite --host 0.0.0.0",
    "build": "node scripts/prepare-document-assets.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "demo:check": "wrangler deploy --config deploy/wrangler.json --dry-run --outdir work/worker-build",
    "demo:deploy": "node scripts/deploy-private-demo.mjs",
    "build:accounts": "node scripts/prepare-document-assets.mjs && tsc -b && vite build --mode accounts",
    "build:v1-demo": "node scripts/prepare-document-assets.mjs && tsc -b && vite build --mode v1demo"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@tesseract.js-data/fra": "1.0.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.149.0"
  }
}
